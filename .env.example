# Copiază acest fișier ca .env.local și completează valorile. `.env*` NU se urcă în Git.
#
# Dezvoltare locală (Supabase local): rulează `npx supabase start`; în ieșire apar URL-ul API și cheia anon.
#   VITE_SUPABASE_URL=http://127.0.0.1:44321
# Fără aceste valori aplicația pornește în MOD DEMO (fără login, date fictive în browser).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Funcții pe server (opționale local; fără ele, funcția respectivă afișează „indisponibilă local”):
#   ANTHROPIC_API_KEY  citirea bonurilor/facturilor și a ofertelor din imagine
#   ORS_API_KEY        calculul kilometrilor (OpenRouteService)
ANTHROPIC_API_KEY=
ORS_API_KEY=

# Trimitere comenzi pe email prin Microsoft 365 (aplicația Entra a produsului). Fără ele, butonul „Trimite pe email” afișează un mesaj.
VITE_MS_CLIENT_ID=
VITE_MS_TENANT_ID=
